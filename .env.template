# DevOps Monitoring Agent Configuration Template
# Copy this file to .env and update the values

# Application Settings
APP_NAME="DevOps Monitoring Agent"
APP_VERSION="1.0.0"
DEBUG=False

# Database Configuration
DATABASE_TYPE=sqlite  # sqlite or postgresql
# DATABASE_URL=postgresql://user:password@localhost:5432/devops_agent  # For PostgreSQL
SQLITE_DB_PATH=data/devops_agent.db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your_redis_password

# LLM Configuration
LLM_PROVIDER=ollama  # ollama, openai, groq
# OPENAI_API_KEY=your_openai_api_key
# GROQ_API_KEY=your_groq_api_key
OLLAMA_HOST=http://localhost:11434
DEFAULT_MODEL=llama2

# Monitoring Configuration
POLLING_INTERVAL=300  # seconds (5 minutes)
MAX_RETRIES=3
WEBHOOK_PORT=8088
# WEBHOOK_SECRET=your_webhook_secret_for_signature_verification

# Kubernetes Configuration
# KUBECONFIG_PATH=/path/to/your/kubeconfig
K8S_NAMESPACE=default

# Cloud Provider Configuration (optional)
# AWS_PROFILE=your_aws_profile
# GCP_PROJECT=your_gcp_project_id
# AZURE_SUBSCRIPTION=your_azure_subscription_id

# Approval System Configuration
# Telegram
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_CHAT_ID=your_telegram_chat_id

# Slack
# SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# SLACK_CHANNEL=#your-slack-channel

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASSWORD=your_email_password_or_app_password
# ALERT_EMAILS=["admin@company.com", "devops@company.com"]

# RAG Configuration
VECTOR_DB_PATH=data/vector_db
SOP_DOCS_PATH=data/sops
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Security
SECRET_KEY=change-this-in-production-to-a-secure-random-string
# Add allowed commands - these are the default safe commands
ALLOWED_COMMANDS=[
    "kubectl get pods",
    "kubectl get services",
    "kubectl get nodes",
    "kubectl describe pod",
    "kubectl describe service",
    "kubectl describe node",
    "kubectl get events",
    "aws ec2 describe-instances",
    "aws ec2 describe-instance-status",
    "gcloud compute instances list",
    "gcloud compute instances describe",
    "az vm list",
    "az vm show"
]

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/devops_agent.log